{
    "type": "confirmation",
    "title": "Multiply",
    "inputs": [
        {
            "key": "m1",
            "type": "text",
            "label": "m1",
            "max_length": 11
        },
        {
            "key": "e1",
            "type": "text",
            "label": "e1",
            "max_length": 11
        },
        {
            "key": "m2",
            "type": "text",
            "label": "m2",
            "max_length": 11
        },
        {
            "key": "e2",
            "type": "text",
            "label": "e2",
            "max_length": 11
        }
    ],
    "yes": {
        "label": "Multiply!",
        "action": {
            "type": "dynamic/run_command",
            "template": "function decimal:dialog/mul {m1:$(m1),e1:$(e1),m2:$(m2),e2:$(e2)}"
        }
    },
    "no": {
        "label": "No"
    }
}